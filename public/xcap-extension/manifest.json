{
  "manifest_version": 3,
  "name": "XCap",
  "version": "2.3.0",
  "description": "Capture DexScreener pools and CoinMarketCap contracts. Nothing runs until you press Scan.",
  "permissions": [
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://dexscreener.com/*",
    "https://*.dexscreener.com/*",
    "https://io.dexscreener.com/*",
    "https://coinmarketcap.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chart & Token Capture",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://dexscreener.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://dexscreener.com/*"
      ],
      "js": [
        "content-dexscreener.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://coinmarketcap.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://coinmarketcap.com/*"
      ],
      "js": [
        "content-cmc.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
